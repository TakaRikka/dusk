                    "ih03-i01-desc": "Controls vertical gyro aiming sensitivity.",
                "ih03-i02": "Gyro Yaw Sensitivity",
                    "ih03-i02-desc": "Controls horizontal gyro aiming sensitivity.",
                "ih03-i03": "Gyro Rollgoal Sensitivity",
                    "ih03-i03-desc": "Controls how strongly gyro input tilts the Rollgoal table.",
                "ih03-i04": "Gyro Deadband",
                    "ih03-i04-desc": "Ignores small gyro movement to reduce drift and jitter.",
                "ih03-i05": "Gyro Smoothing",
                    "ih03-i05-desc": "Higher values smooth gyro input over time.",
                "ih03-b03": "Invert Gyro Pitch",
                    "ih03-b03-desc": "Invert vertical gyro aiming.",
