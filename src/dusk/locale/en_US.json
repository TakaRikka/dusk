            "input-h02": "Camera",
                "ih02-b01": "Free Camera",
                    "ih02-b01-desc": "Enables twin-stick camera control, letting the C-Stick move the camera vertically as well as horizontally.",
                "ih02-b02": "Invert Camera X Axis",
                    "ih02-b02-desc": "Invert horizontal camera movement.",
