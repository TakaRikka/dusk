                    "ih02-b03-desc": "Invert vertical camera movement when Free Camera is enabled.",
                "ih02-i01": "Free Camera Sensitivity",
                    "ih02-i01-desc": "Adjusts twin-stick camera sensitivity.",
                "ih02-b04": "Invert First Person X Axis",
                    "ih02-b04-desc": "Invert horizontal movement while aiming with items or first person camera. Applies only to the control stick (the gyroscope can be inverted in input settings)",
                "ih02-b05": "Invert First Person Y Axis",
                    "ih02-b05-desc": "Invert vertical movement while aiming with items or first person camera. Applies only to the control stick (the gyroscope can be inverted in input settings)",
            "input-h03": "Gyro",
                "ih03-d01": "Gyro Input Method",
                    "ih03-d01-desc": "<br/><b>Sensor</b> reads motion directly from a supported controller's gyro via SDL.<br/><br/><b>Mouse</b> treats mouse input as gyro, intended for use with the Steam Deck.<br/><br/>Mouse input cannot currently be used with Gyro Rollgoal.",
                "ih03-b01": "Gyro Aim",
                    "ih03-b01-desc": "Enables gyro controls while in look mode, aiming a hawk, and aiming supported items.<br/><br/>Supported items include the Slingshot, Gale Boomerang, Hero's Bow, Clawshot(s), Ball and Chain, and Dominion Rod.",
                "ih03-b02": "Gyro Rollgoal",
                    "ih03-b02-desc": "Enables gyro controls for Rollgoal in Hena's Cabin.",
