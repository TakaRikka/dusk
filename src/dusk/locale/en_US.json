        "tab-gameplay": "Gameplay",
            "gameplay-h01": "General",
                "gh01-b01": "Mirror Mode",
                    "gh01-b01-desc": "Mirrors the world horizontally, matching the Wii version of the game.",
                "gh01-b02": "Minimal HUD",
                    "gh01-b02-desc": "Disables the elements of the main HUD of the game.<br/>Useful for a more immersive experience.",
                "gh01-b03": "Restore Wii 1.0 Glitches",
                    "gh01-b03-desc": "Restores patched glitches from Wii USA 1.0, the first released version.",
                "gh01-b04": "Enable Rotating Link Doll",
                    "gh01-b04-desc": "Enables rotating Link in the collection menu with the C-Stick.",
            "gameplay-h02": "Difficulty",
                "gh02-i01": "Damage Multiplier",
                    "gh02-i01-desc": "Multiplies incoming damage.",
                "gh02-b01": "Instant Death",
                    "gh02-b01-desc": "Any hit will instantly kill you.",
                "gh02-b02": "No Heart Drops",
                    "gh02-b02-desc": "Hearts will never drop from enemies, pots, and various other places.",
            "gameplay-h03": "Quality of Life",
                "gh03-b01": "Bigger Wallets",
                    "gh03-b01-desc": "Wallet sizes are like in the HD version. (500, 1000, 2000)",
                "gh03-b02": "Disable Rupee Cutscenes",
                    "gh03-b02-desc": "Rupees will not play cutscenes after you have collected them the first time.",
                "gh03-b03": "Faster Climbing",
                    "gh03-b03-desc": "Quicker climbing on ladders and vines like the HD version.",
                "gh03-b04": "Faster Tears of Light",
                    "gh03-b04-desc": "Tears of Light dropped by Shadow Insects pop out faster like the HD version.",
                "gh03-b05": "Autosave",
                    "gh03-b05-desc": "Autosaves the game when going to a new area, opening a dungeon door, or getting a new item.",
                "gh03-b06": "Instant Saves",
                    "gh03-b06-desc": "Skips the delay when writing to the Memory Card.",
                "gh03-b07": "Hold B for Instant Text",
                    "gh03-b07-desc": "Makes text scroll immediately by holding B.",
                "gh03-b08": "No Climbing Miss Animation",
                    "gh03-b08-desc": "Prevents Link from playing a struggle animation when grabbing ledges or climbing on vines.",
                "gh03-b09": "No Rupee Returns",
                    "gh03-b09-desc": "Always collect Rupees even if your Wallet is too full.",
                "gh03-b10": "No Sword Recoil",
                    "gh03-b10-desc": "Link will not recoil when his sword hits walls.",
                "gh03-b11": "No 2nd Fish for Cat",
                    "gh03-b11-desc": "Skip needing to catch a second fish for Sera's cat.",
                "gh03-b12": "Sun's Song (R+X)",
                    "gh03-b12-desc": "Allows Wolf Link to howl and change the time of day.",
                "gh03-b13": "Quick Transform (R+Y)",
                    "gh03-b13-desc": "Transform instantly by pressing R and Y simultaneously.",
            "gameplay-h04": "Speedrunning",
                "gh04-b01": "Speeddrun Mode",
                    "gh04-b01-desc": "Enables speedrunning options while restricting certain gameplay modifiers.",
                "gh04-b02": "LifeSplit Connection",
                    "gh04-b02-desc": "Connect to LiveSplit server on localhost:16834. For this to work you must right click LiveSplit, and turn on Control -> Start TCP Server. To see IGT in LiveSplit you must change your comparison to Game Time.",
                "gh04-b03": "Show RTA",
                    "gh04-b03-desc": "Display th e RTA timer. IGT is always visible.",

