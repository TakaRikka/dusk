+bool is_bc_format(wgpu::TextureFormat format) noexcept {
+  switch (format) {
+  case wgpu::TextureFormat::BC1RGBAUnorm:
+  case wgpu::TextureFormat::BC3RGBAUnorm:
+  case wgpu::TextureFormat::BC5RGUnorm:
+  case wgpu::TextureFormat::BC7RGBAUnorm:
+    return true;
+  default:
+    return false;
+  }
+}
+
+#if defined(TARGET_OS_IOS) && TARGET_OS_IOS && !TARGET_OS_MACCATALYST
+uint8_t expand_5_to_8(uint16_t v) noexcept { return static_cast<uint8_t>((v << 3) | (v >> 2)); }
+uint8_t expand_6_to_8(uint16_t v) noexcept { return static_cast<uint8_t>((v << 2) | (v >> 4)); }
+
+std::array<uint8_t, 4> decode_rgb565(uint16_t value) noexcept {
+  return {
+      expand_5_to_8((value >> 11) & 0x1f),
+      expand_6_to_8((value >> 5) & 0x3f),
+      expand_5_to_8(value & 0x1f),
+      255,
+  };
+}
+
+uint16_t read_le16(const uint8_t* data) noexcept {
+  return static_cast<uint16_t>(data[0]) | (static_cast<uint16_t>(data[1]) << 8);
+}
+
+uint32_t read_le32(const uint8_t* data) noexcept {
+  return static_cast<uint32_t>(data[0]) | (static_cast<uint32_t>(data[1]) << 8) |
+         (static_cast<uint32_t>(data[2]) << 16) | (static_cast<uint32_t>(data[3]) << 24);
+}
+
+std::array<uint8_t, 16> decode_bc_alpha_block(const uint8_t* src) noexcept {
+  std::array<uint8_t, 8> palette{};
+  palette[0] = src[0];
+  palette[1] = src[1];
+  if (palette[0] > palette[1]) {
+    for (uint32_t i = 1; i < 7; ++i) {
+      palette[i + 1] = static_cast<uint8_t>(((7 - i) * palette[0] + i * palette[1]) / 7);
+    }
+  } else {
+    for (uint32_t i = 1; i < 5; ++i) {
+      palette[i + 1] = static_cast<uint8_t>(((5 - i) * palette[0] + i * palette[1]) / 5);
+    }
+    palette[6] = 0;
+    palette[7] = 255;
+  }
+
+  uint64_t bits = 0;
+  for (uint32_t i = 0; i < 6; ++i) {
+    bits |= static_cast<uint64_t>(src[2 + i]) << (8 * i);
+  }
+
+  std::array<uint8_t, 16> out{};
+  for (uint32_t i = 0; i < out.size(); ++i) {
+    out[i] = palette[(bits >> (3 * i)) & 0x7];
+  }
+  return out;
+}
+
+void decode_bc1_color_block(const uint8_t* src, uint8_t* dst, uint32_t width, uint32_t height, uint32_t blockX,
+                            uint32_t blockY, const uint8_t* alpha = nullptr) noexcept {
+  const uint16_t color0 = read_le16(src);
+  const uint16_t color1 = read_le16(src + 2);
+  std::array<std::array<uint8_t, 4>, 4> palette{};
+  palette[0] = decode_rgb565(color0);
+  palette[1] = decode_rgb565(color1);
+  if (color0 > color1 || alpha != nullptr) {
+    for (uint32_t c = 0; c < 3; ++c) {
+      palette[2][c] = static_cast<uint8_t>((2 * palette[0][c] + palette[1][c]) / 3);
+      palette[3][c] = static_cast<uint8_t>((palette[0][c] + 2 * palette[1][c]) / 3);
+    }
+    palette[2][3] = 255;
+    palette[3][3] = 255;
+  } else {
+    for (uint32_t c = 0; c < 3; ++c) {
+      palette[2][c] = static_cast<uint8_t>((palette[0][c] + palette[1][c]) / 2);
+    }
+    palette[2][3] = 255;
+    palette[3] = {0, 0, 0, 0};
+  }
+
+  const uint32_t indices = read_le32(src + 4);
+  for (uint32_t y = 0; y < 4; ++y) {
+    const uint32_t dstY = blockY * 4 + y;
+    if (dstY >= height) {
+      continue;
+    }
+    for (uint32_t x = 0; x < 4; ++x) {
+      const uint32_t dstX = blockX * 4 + x;
+      if (dstX >= width) {
+        continue;
+      }
+      const uint32_t index = (indices >> (2 * (4 * y + x))) & 0x3;
+      uint8_t* pixel = dst + (static_cast<size_t>(dstY) * width + dstX) * 4;
+      pixel[0] = palette[index][0];
+      pixel[1] = palette[index][1];
+      pixel[2] = palette[index][2];
+      pixel[3] = alpha != nullptr ? alpha[4 * y + x] : palette[index][3];
+    }
+  }
+}
+
+void copy_decoded_rgba_block(const uint8_t* block, uint8_t* dst, uint32_t width, uint32_t height, uint32_t blockX,
+                             uint32_t blockY) noexcept {
+  for (uint32_t y = 0; y < 4; ++y) {
+    const uint32_t dstY = blockY * 4 + y;
+    if (dstY >= height) {
+      continue;
+    }
+    for (uint32_t x = 0; x < 4; ++x) {
+      const uint32_t dstX = blockX * 4 + x;
+      if (dstX >= width) {
+        continue;
+      }
+      std::memcpy(dst + (static_cast<size_t>(dstY) * width + dstX) * 4, block + (y * 4 + x) * 4, 4);
+    }
+  }
+}
+
+ByteBuffer decode_bc_to_rgba8(const ConvertedTexture& texture) noexcept {
+  const uint64_t outSize = calc_texture_size(wgpu::TextureFormat::RGBA8Unorm, texture.width, texture.height, texture.mips);
+  if (outSize == 0 || outSize > kMaxMobileReplacementBytes) {
+    return {};
+  }
+
+  ByteBuffer out{static_cast<size_t>(outSize)};
+  uint64_t inOffset = 0;
+  uint64_t outOffset = 0;
+  const uint32_t blockBytes = texture.format == wgpu::TextureFormat::BC1RGBAUnorm ? 8u : 16u;
+  for (uint32_t mip = 0; mip < texture.mips; ++mip) {
+    const uint32_t width = std::max(texture.width >> mip, 1u);
+    const uint32_t height = std::max(texture.height >> mip, 1u);
+    const uint32_t blocksX = (width + 3) / 4;
+    const uint32_t blocksY = (height + 3) / 4;
+    const uint64_t mipInBytes = static_cast<uint64_t>(blocksX) * blocksY * blockBytes;
+    const uint64_t mipOutBytes = static_cast<uint64_t>(width) * height * 4;
+    if (inOffset + mipInBytes > texture.data.size() || outOffset + mipOutBytes > out.size()) {
+      return {};
+    }
+
+    const uint8_t* mipSrc = texture.data.data() + inOffset;
+    uint8_t* mipDst = out.data() + outOffset;
+    for (uint32_t by = 0; by < blocksY; ++by) {
+      for (uint32_t bx = 0; bx < blocksX; ++bx) {
+        const uint8_t* block = mipSrc + (static_cast<size_t>(by) * blocksX + bx) * blockBytes;
+        if (texture.format == wgpu::TextureFormat::BC1RGBAUnorm) {
+          decode_bc1_color_block(block, mipDst, width, height, bx, by);
+        } else if (texture.format == wgpu::TextureFormat::BC3RGBAUnorm) {
+          const auto alpha = decode_bc_alpha_block(block);
+          decode_bc1_color_block(block + 8, mipDst, width, height, bx, by, alpha.data());
+        } else if (texture.format == wgpu::TextureFormat::BC5RGUnorm) {
+          const auto red = decode_bc_alpha_block(block);
+          const auto green = decode_bc_alpha_block(block + 8);
+          for (uint32_t y = 0; y < 4; ++y) {
+            const uint32_t dstY = by * 4 + y;
+            if (dstY >= height) {
+              continue;
+            }
+            for (uint32_t x = 0; x < 4; ++x) {
+              const uint32_t dstX = bx * 4 + x;
+              if (dstX >= width) {
+                continue;
+              }
+              uint8_t* pixel = mipDst + (static_cast<size_t>(dstY) * width + dstX) * 4;
+              pixel[0] = red[4 * y + x];
+              pixel[1] = green[4 * y + x];
+              pixel[2] = 255;
+              pixel[3] = 255;
+            }
+          }
+        } else if (texture.format == wgpu::TextureFormat::BC7RGBAUnorm) {
+          std::array<uint8_t, 64> decoded{};
+          bcdec_bc7(block, decoded.data(), 16);
+          copy_decoded_rgba_block(decoded.data(), mipDst, width, height, bx, by);
+        }
+      }
+    }
+    inOffset += mipInBytes;
+    outOffset += mipOutBytes;
+  }
+  return out;
+}
+
+bool prepare_mobile_replacement(ConvertedTexture& replacement, const RuntimeTextureKey& key) noexcept {
+  if (is_bc_format(replacement.format)) {
+    ByteBuffer rgba = decode_bc_to_rgba8(replacement);
+    if (rgba.empty()) {
+      Log.warn("texture_replacement: failed to decode compressed replacement on iOS: {}",
+               format_replacement_filename(key));
+      return false;
+    }
+    replacement.format = wgpu::TextureFormat::RGBA8Unorm;
+    replacement.data = std::move(rgba);
+  }
+
+  const uint64_t replacementBytes =
+      calc_texture_size(replacement.format, replacement.width, replacement.height, replacement.mips);
+  if (replacementBytes == 0 || replacementBytes > kMaxMobileReplacementBytes) {
+    Log.warn("texture_replacement: skipping oversized iOS replacement {} ({} bytes)",
+             format_replacement_filename(key), replacementBytes);
+    return false;
+  }
+  return true;
+}
+#endif
+
+bool validate_replacement_for_upload(ConvertedTexture& replacement, const RuntimeTextureKey& key) noexcept {
+#if defined(TARGET_OS_IOS) && TARGET_OS_IOS && !TARGET_OS_MACCATALYST
+  if (!prepare_mobile_replacement(replacement, key)) {
+    return false;
+  }
+#endif
+
+  wgpu::Limits limits{};
+  g_device.GetLimits(&limits);
+  if (limits.maxTextureDimension2D != 0 &&
+      (replacement.width > limits.maxTextureDimension2D || replacement.height > limits.maxTextureDimension2D)) {
+    Log.warn("texture_replacement: skipping replacement {}x{} above device limit {}: {}", replacement.width,
+             replacement.height, limits.maxTextureDimension2D, format_replacement_filename(key));
+    return false;
+  }
+  return true;
+}
